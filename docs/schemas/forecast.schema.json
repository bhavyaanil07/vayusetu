          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "pm25_p10": {
          "title": "Pm25 P10",
          "type": "number"
        },
        "pm25_p50": {
          "title": "Pm25 P50",
          "type": "number"
        },
        "pm25_p90": {
          "title": "Pm25 P90",
          "type": "number"
        },
        "aqi": {
          "title": "Aqi",
          "type": "number"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "prob_very_poor": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prob Very Poor",
          "type": "number"
        },
        "prob_severe": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prob Severe",
          "type": "number"
        }
      },
      "required": [
        "window",
        "start",
        "end",
        "pm25_p10",
        "pm25_p50",
