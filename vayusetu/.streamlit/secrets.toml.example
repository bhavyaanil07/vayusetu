# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud > App settings > Secrets.
# All keys are OPTIONAL - the app works without any of them.

# NASA FIRMS map key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY = ""

# data.gov.in API key (free) for CPCB real-time station readings
DATA_GOV_IN_API_KEY = ""

# Your own VayuSetu sensor node on ThingSpeak (see hardware/sds011_node.py)
THINGSPEAK_CHANNEL_ID = ""
THINGSPEAK_READ_KEY = ""

# Slack / Teams / Discord incoming-webhook URL to receive dispatched alerts
VAYUSETU_WEBHOOK_URL = ""
