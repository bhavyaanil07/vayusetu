    "hotspot_id": {
      "title": "Hotspot Id",
      "type": "string"
    },
    "city": {
      "title": "City",
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "title": "Time",
      "type": "string"
    },
    "lat": {
      "title": "Lat",
      "type": "number"
    },
    "lon": {
      "title": "Lon",
      "type": "number"
    },
    "radius_km": {
      "title": "Radius Km",
      "type": "number"
    },
    "peak_pm25": {
      "title": "Peak Pm25",
      "type": "number"
    },
    "peak_excess": {
